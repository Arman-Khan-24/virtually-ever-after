  "490f01db170b": {
    "title": "Selin Gencoglu · SELINGENCOGLU",
    "description": "Selin Gencoglu paints demons in dark, unsettling rooms. Her work runs on chaos, fear, tension, unease. The website was built as the place those paintings come from: a 3D world rendered as the source of the imagery. A figure was pulled from each canvas, sketched again by the artist, and placed inside an environment constructed from scratch. Visitors step into that atmosphere and move through it themselves, becoming part of the experience the paintings describe.",
    "media": [
      {
        "src": "/assets/offline/428c902134c636fe.mp4",
        "kind": "video"
      },
      {
        "src": "/assets/offline/ad2e414bb7932523.png",
        "kind": "image"
      }
    ]
  },
  "6188fbe1f502": {
    "title": "Laila · LAILA",
    "description": " Laila is built around what a date can actually be, and the landing page argues it in film. Joy, movement, and time spent well together are cut into a single sequence, held in an interface stripped back far enough to explain the whole app in one scroll.",
