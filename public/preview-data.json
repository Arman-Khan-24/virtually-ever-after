  "dac610913065": {
    "title": "C2W2 · C2W2ART",
    "description": "The C2W2 avatar collection and runway left a large body of material behind. The site organises all of it inside an interface everyone already knows: a desktop file system. Folders open, files are clicked through, and the archive is explored the way people sort their own machines every day. Browsing a website usually feels like visiting one. Minimise the window and the desktop underneath feels like home. C2W2 was built to feel like the desktop.",
    "media": [
      {
        "src": "/assets/offline/d6932c0a17d06cf9.png",
        "kind": "image"
